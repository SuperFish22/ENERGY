# ===== Сайт =====
# Адрес сайта, без слэша в конце
SITE_URL=https://energy-academy.ru
# Город в предложном падеже: «обучение вожатых в Москве»
SITE_CITY=Москве
# Длинная случайная строка: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=

# ===== Telegram =====
# Токен от @BotFather
BOT_TOKEN=
# Имя бота без @ (для кнопки «Войти через Telegram»). В @BotFather: /setdomain -> ваш домен
BOT_USERNAME=
# Ключ для бота на другом сервере — ОДИНАКОВЫЙ здесь и в bot/.env.
# Придумать: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
# Когда ключ задан, сайт сам в Telegram не пишет: заявки забирает и отправляет бот.
BOT_API_TOKEN=
# Только если бот НЕ вынесен на другой сервер (BOT_API_TOKEN пустой): чат для заявок
LEADS_CHAT_ID=
# Telegram id главных админов через запятую (всегда «Руководитель»). Свой id: напишите @userinfobot
SUPERADMIN_IDS=

# ===== Ссылки =====
VK_URL=https://vk.com/planeta.energy
TG_CHANNEL_URL=https://t.me/energy_getdrive
CONTACT_EMAIL=brio.laboratory@gmail.com

# ===== Только для разработки на своём компьютере (на сервере 0!) =====
DEV_LOGIN=0
