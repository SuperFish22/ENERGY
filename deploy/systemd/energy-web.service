# Сайт ENERGY без Docker. Положить в /etc/systemd/system/, затем:
#   sudo systemctl daemon-reload && sudo systemctl enable --now energy-web
[Unit]
Description=ENERGY — сайт (uvicorn)
After=network.target

[Service]
User=energy
Group=energy
WorkingDirectory=/opt/energy-site
EnvironmentFile=/opt/energy-site/.env
ExecStart=/opt/energy-site/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
