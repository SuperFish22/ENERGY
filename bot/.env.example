# ===== Телеграм-бот ENERGY (отдельный сервер) =====
# Токен от @BotFather — тот же, что в .env сайта
BOT_TOKEN=
# Адрес сайта, без слэша в конце
SITE_URL=https://energy-academy.ru
# Ключ для связи с сайтом — ОДИНАКОВЫЙ здесь и в .env сайта.
# Придумать: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
BOT_API_TOKEN=
# Куда слать заявки: добавьте бота в чат организаторов и напишите там /chatid
LEADS_CHAT_ID=
# Как часто проверять новые заявки, секунд
POLL_SECONDS=15
